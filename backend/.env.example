# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/chatdb

# JWT
SECRET_KEY=change-me-to-a-long-random-secret
OAUTH_TOKEN_ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI (platform-wide key)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# App
APP_NAME=ChatSystem
WIDGET_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# WhatsApp Cloud API (Global fallback)
WHATSAPP_ACCESS_TOKEN=your-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Meta Embedded Signup
NEXT_PUBLIC_FACEBOOK_APP_ID=your-app-id
FB_CLIENT_SECRET=your-client-secret
